#!/usr/bin/env bash
# Clean-room gate, push level.  The commit gate only ever sees the index of
# one commit; this one re-checks every commit actually leaving the machine, so
# a commit made before the hooks existed -- or made in another clone, or
# amended past the gate -- still cannot reach a remote.
#
# git calls this with the remote name in $1 and its URL in $2, and feeds one
# line per pushed ref on stdin:
#
#     <local ref> <local sha> <remote ref> <remote sha>
#
# Active once `git config core.hooksPath .githooks` has been run; `gmake setup`
# does that.  See CLAUDE.md.  Do not pass --no-verify.

set -u

remote_name=${1-origin}
remote_url=${2-}

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

ZERO=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -n "${local_sha:-}" ] || continue

	# Deleting a remote branch pushes no objects; there is nothing to scan.
	if [ "$local_sha" = "$ZERO" ]; then
		echo "pre-push: $remote_ref is being deleted, nothing to scan"
		continue
	fi

	have_remote=0
	if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
		have_remote=1
	fi

	if [ "$have_remote" = 1 ]; then
		# Updating an existing remote branch: scan what is new.
		range="$remote_sha..$local_sha"
		label="$remote_ref ($range)"
	else
		# New branch, or a remote tip this clone has never seen.
		#
		# Scan the commits this push can introduce, and only those.  Excluding
		# refs/remotes/* is not good enough: those refs go stale across a
		# history rewrite and would then hide commits the push transmits.  Ask
		# the actual push destination ($2), not the named remote's fetch URL,
		# which heads it has right now, and exclude a tip only when
		# this clone actually has that commit.  If the remote cannot be read,
		# scan the whole branch.  That fails closed.
		tips_file=$(mktemp)
		if [ -n "$remote_url" ] && git ls-remote --heads -- "$remote_url" >"$tips_file"; then
			exclude=""
			while read -r tip refname; do
				[ -n "${tip:-}" ] || continue
				if git cat-file -e "$tip^{commit}" 2>/dev/null; then
					exclude="$exclude $tip"
				fi
			done <"$tips_file"
			rm -f "$tips_file"
			if [ -n "$exclude" ]; then
				range="$local_sha --not$exclude"
				label="$remote_ref (new branch, commits not already on $remote_name)"
			else
				range="$local_sha"
				label="$remote_ref (new branch, full scan)"
			fi
		else
			rm -f "$tips_file"
			echo "pre-push: cannot read heads from the push destination; scanning the whole branch" >&2
			range="$local_sha"
			label="$remote_ref (new branch, full scan)"
		fi
	fi

	echo "pre-push: clean-room scan of $label"
	# shellcheck disable=SC2086
	if ! bash tools/cleanroom_check.sh --range "$range"; then
		status=1
	fi
done

if [ "$status" -ne 0 ]; then
	cat >&2 <<'EOF'

pre-push: BLOCKED by the clean-room gate.

At least one commit in this push carries ROM-derived content.  It is already
in history, so removing it means rewriting -- `git rebase -i` to drop or edit
the commit, or `git filter-repo --path <file> --invert-paths` -- not a follow-up
commit that deletes the file.  A deletion commit still ships the bytes.

Do not push with --no-verify.
EOF
	exit 1
fi
