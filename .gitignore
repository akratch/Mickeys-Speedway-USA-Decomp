# ROMs and anything extracted from them — never committed (clean room)
*.z64
*.n64
*.v64
baseroms
asm/
assets/
bin/
expected/
.splat_cache

# Build output
build/
build_*/

# Proprietary toolchain binaries (fetched/copied locally, never committed)
tools/ido
tools/binutils

# objdiff-cli binary (tools/setup_objdiff.sh); objdiff.json is generated too
# but committed (paths/names only, no ROM content -- the project's objdiff
# config). tools/objdiff_exclude.txt is also generated (a grep over the
# Makefile) but NOT committed: ~700 lines of nothing but object-file
# basenames reads as high-entropy text to the cleanroom base64-volume
# heuristic, a real false positive on this file shape -- see docs/tools.md
# and docs/CLEANROOM.md. tools/objdiff_report.sh regenerates it every run.
tools/objdiff
/tools/objdiff_exclude.txt

# Local symlink to a decomp-permuter checkout (path is this machine's, e.g.
# ~/Desktop/dev/decomp-permuter -- see tools/permute.sh and docs/tools.md).
tools/permuter

# Generated
undefined_funcs_auto*.txt
undefined_syms_auto*.txt
ctx.c
ctx_includes.c
ctx.c.m2c
*.i
*.o
# IDO writes a `.u` ucode/debug sidecar into the CWD for every -g3 compile
# (see the Makefile's LIBULTRA_O2_G3_TUS block). It is a build product of THIS
# tree's own source, not of the ROM, but it lands in the repo root rather than
# build/ and there is no flag to relocate it.
*.u

# Environment
.venv
__pycache__/
.DS_Store

# Process artifacts (planning/review scratch, not build inputs)
.superpowers/

# Decompilation workbench state: candidate ledgers record the ROM's own
# instruction text in their diff sites, so the tree is ignored wholesale.
# Only the per-campaign manifest (paths + hashes, no ROM content) is tracked.
.decomp-workbench/**

